# 智能巡飞弹集群决策系统 — 环境变量样例
#
# 复制为 .env 并填入真实值。JEV_MODE=mock 时不需 LLM/Jev key 也可端到端跑通
# （intent/plan/schema 都从 scenario YAML 读预制结果）。
# 跑实时 demo（demo_live.py）时需把 LLM/JEV 都置为 real。

# === 外环 Agent LLM（OpenAI 兼容协议，示例：DeepSeek）===
# DeepSeek 官方 endpoint：https://api.deepseek.com/v1
# model 可选：deepseek-chat（通用对话）/ deepseek-reasoner（R1 推理增强）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_SEED=42

# === 内环 Jev（本地部署的 Laya 决策模型）===
# JEV_MODE=mock  → 用确定性 mock（脚本驱动 + 启发式兜底 + 种子化随机）
# JEV_MODE=real  → 调本地 Laya HTTP 服务（需 JEV_BASE_URL，无需 JEV_API_KEY）
# 本地 Laya 接口文档：http://localhost:8000/docs（POST /api/v1/predict）
JEV_BASE_URL=http://localhost:8000
JEV_API_KEY=
JEV_MODE=mock

# === 仿真内核 ===
SIM_TICK_MS=200
SIM_SEED=42

# === 实时 demo（demo_live.py）专属 ===
# 每帧之间的停顿秒数（0=不停顿，最快跑完）
DEMO_TICK_SLEEP=0.8
# 是否清屏（false=逐帧追加打印，历史保留（默认）；true=每帧清屏覆盖）
DEMO_CLEAR_SCREEN=false
# 抑制重规划（true=Demo 模式下跳过所有 escalation/replan，让 coverage 逐帧推进）
DEMO_SUPPRESS_REPLAN=true
# 每个搜索态弹每 tick 的 coverage 增量（默认 0.005 → 9 弹约 23 tick 填满）
DEMO_COV_DELTA=0.005
# 最大 tick 数（覆盖 DEMO_SCENARIO 中的默认值）
# DEMO_MAX_TICKS=30
# 场景选择：cooperative_search | cooperative_attack | adhoc_events
# DEMO_SCENARIO=cooperative_search
